# Copiar a .env (que esta en .gitignore) y completar. Ningun valor real de
# produccion vive en un archivo: en AWS los inyecta la definicion de tarea de
# ECS desde Parameter Store, y crear o rotar un parametro es tarea humana.

# Base local que levanta docker-compose de la raiz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/{{PROYECTO}}"

# Puerto del API y origen del frontend permitido por CORS.
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Auth. Sin CLERK_SECRET_KEY y sin ALLOW_DEV_AUTH=true el API NO arranca: es
# fail-closed a proposito. ALLOW_DEV_AUTH acepta la identidad que manda el
# cliente por el header x-dev-user-id, asi que SOLO va en una maquina de
# desarrollo. Las claves salen de la instancia de DEV de Clerk (separada de la
# de produccion) y no se pegan en ningun otro archivo.
ALLOW_DEV_AUTH=true
CLERK_SECRET_KEY=""
CLERK_JWT_KEY=""
